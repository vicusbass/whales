---
import Layout from '../layouts/Layout.astro';
import WhaleTreeView from '../components/WhaleTreeView.astro';
import WhaleGraph from '../components/WhaleGraph.astro';
import {
  byId,
  childrenOf,
  counts,
  iucnBreakdown,
  nodes,
  shortLabel,
  speciesUnder,
} from '../utils/whales';
import { TAXON_COPY } from '../data/taxonCopy';
import {
  canonicalUrl,
  graph,
  higherTaxon,
  publisher,
  webPage,
  webSite,
} from '../utils/seo';

// "forty-four" in the hero is spelled out in the design; keep the numeral and
// the word in step if the dataset ever changes.
const SPELLED: Record<number, string> = {
  42: 'forty-two',
  43: 'forty-three',
  44: 'forty-four',
  45: 'forty-five',
  46: 'forty-six',
};
const spelledSpecies = SPELLED[counts.species] ?? String(counts.species);

const stats = [
  { value: counts.species, label: 'living species' },
  { value: counts.genera, label: 'genera' },
  { value: counts.families, label: 'families' },
  { value: counts.suborders, label: 'suborders — baleen & toothed' },
];

// The radial graph builds its nodes in the browser, so the families and genera
// it draws are not links a crawler can follow. This strip is the same tree in
// markup: it is the only place on the site, outside a species' breadcrumbs,
// where every family and genus page is linked.
const familyIndex = nodes
  .filter((n) => n.type === 'suborder')
  .map((suborder) => ({
    suborder,
    families: childrenOf(suborder.id)
      .filter((n) => n.type === 'family')
      .map((family) => ({
        family,
        genera: childrenOf(family.id).filter((n) => n.type === 'genus'),
        count: speciesUnder(family.id).length,
      })),
  }));

const description =
  'An atlas of every living whale species, mapped across the branches of life — taxonomy, photographs and IUCN conservation status for all 44.';

const url = canonicalUrl('/');
const jsonLd = graph([
  webSite(),
  publisher(),
  webPage({
    url,
    name: 'Whale Encyclopedia',
    description,
    primaryEntityId: `${canonicalUrl('/order/cetacea')}#taxon`,
  }),
  higherTaxon(byId.cetacea, childrenOf('cetacea'), TAXON_COPY.cetacea?.summary),
]);
---

<Layout title="Whale Encyclopedia" description={description} jsonLd={jsonLd}>
  {/* ---------- Atlas ---------- */}
  <div class="atlas-only">
    <section class="hero">
      <div class="kicker">Order Cetacea</div>
      <h1 class="t-display hero__title">
        An atlas of the<br /><em>{spelledSpecies}</em> whales
      </h1>
      <p class="hero__lede">
        From the colossal blue whale to the elusive beaked whales of the deep,
        every living species mapped across the branches of life.
      </p>
    </section>

    <WhaleGraph />

    <section class="stats">
      {
        stats.map((s) => (
          <div>
            <div class="t-display stats__value">{s.value}</div>
            <div class="stats__label">{s.label}</div>
          </div>
        ))
      }
    </section>

    <section class="conservation">
      <h2 class="t-display conservation__title">Conservation status</h2>
      <p class="conservation__lede">
        Centuries of whaling, entanglement, ship strikes and a warming ocean
        have left many species at risk. Colour marks each species' standing on
        the IUCN Red List.
      </p>

      <div class="conservation__bar">
        {
          iucnBreakdown.map((s) => (
            <div
              title={`${s.status} · ${s.count}`}
              style={`flex:${s.count};background:${s.color};`}
            />
          ))
        }
      </div>

      <div class="conservation__legend">
        {
          iucnBreakdown.map((s) => (
            <div>
              <span style={`background:${s.color};`} />
              {s.status} <b>{s.count}</b>
            </div>
          ))
        }
      </div>

      <a href="/species" class="wbtn conservation__cta"
        >Browse all {counts.species} species</a
      >
    </section>
  </div>

  {/* ---------- Classic ---------- */}
  <div class="classic-only">
    <section class="mb-8">
      {
        /* An <h2>, not an <h1>: the Atlas hero above is this document's single
          <h1>, and both themes are present in the markup at once. `t-h1`
          keeps the Dela Gothic face the Classic theme gave it as an h1. */
      }
      <h2
        class="t-h1 mb-4 border-b border-blue-300 pb-2 text-xl font-bold md:text-2xl"
      >
        Whale Taxonomy Tree
      </h2>
      <p class="mb-6 text-gray-600 md:text-lg">
        Explore the taxonomic classification of whales from order down to genus
        level. Click the + sign to expand each category and discover the
        diversity of whale families and genera, you can click on any category to
        see the whales from it.
      </p>
      <WhaleTreeView />
    </section>

    <section class="mb-8">
      <h2
        class="mb-4 border-b border-blue-300 pb-2 text-xl font-bold md:text-2xl"
      >
        Conservation Status
      </h2>
      <p class="mb-4">
        Many whale species are endangered or threatened due to historical
        whaling, habitat loss, climate change, and other human activities.
      </p>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border-l-4 border-red-600 bg-red-100 p-4">
          <h3 class="font-bold text-red-800">Critically Endangered</h3>
          <p class="mt-1 text-sm">
            Facing an extremely high risk of extinction in the wild
          </p>
        </div>
        <div class="rounded-lg border-l-4 border-orange-600 bg-orange-100 p-4">
          <h3 class="font-bold text-orange-800">Endangered</h3>
          <p class="mt-1 text-sm">
            Facing a very high risk of extinction in the wild
          </p>
        </div>
        <div class="rounded-lg border-l-4 border-yellow-600 bg-yellow-100 p-4">
          <h3 class="font-bold text-yellow-800">Vulnerable</h3>
          <p class="mt-1 text-sm">
            Facing a high risk of extinction in the wild
          </p>
        </div>
        <div class="rounded-lg border-l-4 border-green-600 bg-green-100 p-4">
          <h3 class="font-bold text-green-800">Least Concern</h3>
          <p class="mt-1 text-sm">
            Evaluated as not being at risk of extinction in the near future
          </p>
        </div>
      </div>
    </section>
  </div>

  {/* Shared by both themes — the crawlable index of the taxonomy. */}
  <section class="browse">
    <h2 class="t-display browse__title">Browse the taxonomy</h2>
    <p class="browse__lede">
      Every family and genus in the order, and the species each one holds.
    </p>

    {
      familyIndex.map(({ suborder, families }) => (
        <div class="browse__group">
          <h3 class="browse__suborder">
            <a href={`/suborder/${suborder.id}`}>
              {shortLabel(suborder.label)}
            </a>
            <span>{suborder.common_name ?? ''}</span>
          </h3>
          <ul class="browse__families">
            {families.map(({ family, genera, count }) => (
              <li>
                <a class="browse__family" href={`/family/${family.id}`}>
                  {shortLabel(family.label)}
                </a>
                <span class="browse__count">{count} species</span>
                <ul class="browse__genera">
                  {genera.map((genus) => (
                    <li>
                      <a href={`/genus/${genus.id}`}>
                        {shortLabel(genus.label)}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</Layout>

<style>
  /* --- taxonomy index ---------------------------------------------------- */

  .browse {
    margin: 52px 0 16px;
  }

  .browse__title {
    font-size: clamp(24px, 3.4vw, 34px);
    line-height: 1.1;
    margin: 0 0 10px;
  }

  .browse__lede {
    font-size: 15px;
    color: var(--muted);
    margin: 0 0 26px;
  }

  .browse__group + .browse__group {
    margin-top: 28px;
  }

  .browse__suborder {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 14px;
  }

  .browse__suborder span {
    color: var(--faint);
    letter-spacing: 0.3px;
    text-transform: none;
    font-weight: 400;
  }

  .browse__families {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  }

  .browse__families > li {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: var(--radius-card);
    padding: 14px 16px 15px;
  }

  .browse__family {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
  }

  .browse__count {
    display: block;
    font-size: 11.5px;
    color: var(--faint);
    margin-top: 2px;
  }

  .browse__genera {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .browse__genera a {
    display: inline-block;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    font-size: 12px;
    font-style: italic;
    color: var(--muted);
    text-decoration: none;
  }

  .browse a:hover {
    color: var(--accent);
  }

  :global(html[data-theme='classic']) .browse__title {
    font-size: clamp(20px, 3vw, 24px);
    border-bottom: 1px solid #93c5fd;
    padding-bottom: 0.5rem;
  }

  :global(html[data-theme='classic']) .browse__families > li {
    background: #fff;
    border-color: #e5e7eb;
  }

  :global(html[data-theme='classic']) .browse__genera a {
    border-color: #e5e7eb;
  }

  .hero {
    max-width: 680px;
    margin: 30px 0 40px;
  }

  .kicker {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }

  .hero__title {
    font-size: clamp(40px, 6.4vw, 72px);
    line-height: 1;
    letter-spacing: -1px;
    margin: 0 0 22px;
  }

  .hero__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }

  .hero__lede {
    font-size: clamp(15px, 2vw, 17px);
    line-height: 1.6;
    color: var(--muted);
    max-width: 520px;
    margin: 0;
  }

  .stats {
    margin-top: 56px;
    display: flex;
    gap: 16px 40px;
    flex-wrap: wrap;
    padding: 28px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stats__value {
    font-size: 40px;
    line-height: 1;
  }

  .stats__label {
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 8px;
  }

  .conservation {
    margin-top: 56px;
  }

  .conservation__title {
    font-size: clamp(28px, 3.4vw, 38px);
    letter-spacing: -0.3px;
    margin: 0 0 12px;
  }

  .conservation__lede {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
    max-width: 560px;
    margin: 0 0 26px;
  }

  .conservation__bar {
    display: flex;
    gap: 3px;
    height: 10px;
    margin-bottom: 18px;
  }

  .conservation__bar > div {
    border-radius: 999px;
  }

  .conservation__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }

  .conservation__legend > div {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
  }

  .conservation__legend span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }

  .conservation__legend b {
    color: var(--ink);
    font-weight: 500;
  }

  .conservation__cta {
    display: inline-flex;
    align-items: center;
    margin-top: 30px;
    height: 44px;
    padding: 0 24px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
  }
</style>
