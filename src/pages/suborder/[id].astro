---
import TaxonPage from '../../components/TaxonPage.astro';
import { nodes, type WhaleNode } from '../../utils/whales';

export async function getStaticPaths() {
  return nodes
    .filter((node) => node.type === 'suborder')
    .map((taxon) => ({ params: { id: taxon.id }, props: { taxon } }));
}

const { taxon } = Astro.props as { taxon: WhaleNode };
---

<TaxonPage
  taxon={taxon}
  heading="Species in this Suborder"
  title={`${taxon.label} Whales`}
  description={`Explore all whale species in the ${taxon.label} suborder`}
/>
