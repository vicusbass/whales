---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SpeciesCard from '../../components/SpeciesCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  byId,
  childrenOf,
  imageFor,
  iucnColor,
  lineageOf,
  nodes,
  shortLabel,
  type WhaleNode,
} from '../../utils/whales';

export async function getStaticPaths() {
  return nodes
    .filter((item) => item.type === 'species')
    .map((species) => ({
      params: { id: species.id },
      props: { species },
    }));
}

const { species } = Astro.props as { species: WhaleNode };

const image = imageFor(species.id);
const statusColor = iucnColor(species.iucn_status);
const status = species.iucn_status || 'Not Evaluated';
const lineage = lineageOf(species.id);
const genus = species.parent ? byId[species.parent] : undefined;

// Everything else in the same genus, for the Atlas "Others in …" strip.
const siblings = genus
  ? childrenOf(genus.id).filter(
      (n) => n.type === 'species' && n.id !== species.id
    )
  : [];

const family = genus?.parent ? byId[genus.parent] : undefined;

// Classic theme's border/shadow pair, kept verbatim so the toggle really does
// restore the old page.
const classicFrame: Record<string, string> = {
  'critically endangered': 'border-red-600 shadow-red-200',
  endangered: 'border-orange-600 shadow-orange-200',
  vulnerable: 'border-yellow-600 shadow-yellow-200',
  'near threatened': 'border-amber-600 shadow-amber-200',
  'least concern': 'border-green-600 shadow-green-200',
  'data deficient': 'border-gray-600 shadow-gray-200',
};
const classicBadge: Record<string, string> = {
  'critically endangered': 'bg-red-100 text-red-800',
  endangered: 'bg-orange-100 text-orange-800',
  vulnerable: 'bg-yellow-100 text-yellow-800',
  'near threatened': 'bg-amber-100 text-amber-800',
  'least concern': 'bg-green-100 text-green-800',
};
const statusKey = (species.iucn_status || '').toLowerCase();
const frameClass = classicFrame[statusKey] ?? 'border-gray-400 shadow-gray-200';
const badgeClass = classicBadge[statusKey] ?? 'bg-gray-100 text-gray-800';
---

<Layout
  title={`${species.common_name || species.label} | Whale Encyclopedia`}
  description={`Learn about ${species.common_name || species.label}, ${species.description?.substring(0, 150) || 'a whale species'}`}
>
  <article class="detail" style={`--status:${statusColor};`}>
    <a href="/species" class="wback detail__back atlas-only">← All species</a>

    <Breadcrumbs trail={lineage} />

    <div class="detail__grid">
      <div class="detail__media">
        <div class={`detail__frame ${frameClass}`}>
          <div class="detail__imgwrap" data-detail-zoom={image ? '' : null}>
            {
              image ? (
                <Image
                  src={image}
                  alt={species.common_name || species.label}
                  class="detail__img"
                  width={1000}
                  height={800}
                  loading="eager"
                />
              ) : (
                <div class="detail__placeholder">
                  <span class="icon-[tabler--photo]" />
                  <p>No photo available</p>
                </div>
              )
            }
            {image && <span class="detail__zoom atlas-only">⤢ Full size</span>}
            <span class="detail__status atlas-only">{status}</span>
          </div>

          {
            species.author && (
              <p class="detail__credit" title={species.author}>
                Photo: {species.author}
              </p>
            )
          }

          <div class={`classic-only detail__badge ${badgeClass}`}>{status}</div>
        </div>
      </div>

      <div class="detail__info">
        <h1 class="t-display detail__name">
          {species.common_name || 'Unknown Common Name'}
        </h1>
        <p class="t-sci detail__sci">{species.label}</p>

        <div class="detail__about">
          <h2 class="classic-only detail__about-title">About This Species</h2>

          <div class="detail__stats">
            <div>
              <span>Length</span><strong>{species.size || '—'}</strong>
            </div>
            <div>
              <span>Weight</span><strong>{species.weight || '—'}</strong>
            </div>
          </div>

          <p class="detail__desc">
            {
              species.description ||
                'No description available for this species.'
            }
          </p>
        </div>
      </div>
    </div>

    {
      siblings.length > 0 && (
        <section class="detail__siblings atlas-only">
          <h2 class="t-display detail__siblings-title">
            Others in {genus!.label}
          </h2>
          <div class="detail__siblings-grid">
            {siblings.map((s) => (
              <SpeciesCard
                species={s}
                kicker={family ? shortLabel(family.label) : undefined}
              />
            ))}
          </div>
        </section>
      )
    }
  </article>

  {
    image && (
      <div class="detail-lightbox" data-lightbox hidden>
        <button class="wclose detail-lightbox__close" aria-label="Close">
          ×
        </button>
        <figure>
          <Image
            src={image}
            alt={species.common_name || species.label}
            width={1600}
            height={1200}
            loading="lazy"
          />
          <figcaption>
            <div class="detail-lightbox__common">
              {species.common_name || species.label}
            </div>
            <div class="detail-lightbox__sci">{species.label}</div>
          </figcaption>
        </figure>
      </div>
    )
  }
</Layout>

<style>
  .detail {
    padding-block: 8px 0;
  }

  .detail__back {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    font-size: 13px;
    font-weight: 500;
    height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    text-decoration: none;
    margin-bottom: 18px;
  }

  .detail__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 34px;
    align-items: flex-start;
  }

  .detail__media {
    flex: 1 1 380px;
    min-width: 280px;
  }

  .detail__info {
    flex: 1 1 360px;
    min-width: 280px;
  }

  .detail__imgwrap {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    background: rgba(0, 0, 0, 0.15);
    cursor: zoom-in;
  }

  .detail__img {
    width: 100%;
    display: block;
    object-fit: cover;
    max-height: 480px;
  }

  .detail__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 64px 16px;
    color: var(--faint);
  }

  .detail__placeholder span {
    width: 3rem;
    height: 3rem;
  }

  .detail__zoom {
    position: absolute;
    top: 14px;
    right: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 600;
    color: #fff;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
  }

  .detail__status {
    position: absolute;
    bottom: 14px;
    left: 14px;
    padding: 6px 13px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.3px;
    color: #fff;
    background: var(--status);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
  }

  .detail__credit {
    margin: 8px 0 0;
    text-align: center;
    font-size: 12px;
    font-style: italic;
    color: var(--faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .detail__name {
    font-size: clamp(34px, 4.8vw, 54px);
    line-height: 1;
    letter-spacing: -0.8px;
    margin: 0 0 8px;
  }

  .detail__sci {
    font-size: clamp(17px, 2.4vw, 21px);
    margin: 0 0 24px;
  }

  .detail__stats {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .detail__stats > div {
    flex: 1;
    min-width: 120px;
    padding: 14px 16px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .detail__stats span {
    display: block;
    font-size: 11px;
    color: var(--faint);
    margin-bottom: 4px;
  }

  .detail__stats strong {
    font-size: 17px;
    font-weight: 600;
  }

  .detail__desc {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink);
    opacity: 0.88;
    margin: 0;
  }

  .detail__siblings {
    margin-top: 48px;
  }

  .detail__siblings-title {
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: -0.3px;
    margin: 0 0 20px;
  }

  .detail__siblings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 16px;
  }

  /* --- Classic ----------------------------------------------------------- */

  /* Classic put the photo on the right and the prose on the left. */
  :global(html[data-theme='classic']) .detail__grid {
    gap: 2rem;
  }

  :global(html[data-theme='classic']) .detail__media {
    order: 2;
  }

  :global(html[data-theme='classic']) .detail__info {
    order: 1;
  }

  :global(html[data-theme='classic']) .detail__frame {
    padding: 1rem;
    border-width: 4px;
    border-style: solid;
    border-radius: 1rem;
    background: #ffffff;
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.25),
      0 0 0 1px rgba(0, 0, 0, 0.02);
  }

  @media (min-width: 640px) {
    :global(html[data-theme='classic']) .detail__frame {
      padding: 1.5rem;
    }
  }

  :global(html[data-theme='classic']) .detail__imgwrap {
    border: none;
    border-radius: 0.5rem;
    box-shadow: none;
    background: #f3f4f6;
    cursor: default;
  }

  :global(html[data-theme='classic']) .detail__img {
    object-fit: contain;
    max-height: 600px;
  }

  :global(html[data-theme='classic']) .detail__badge {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  @media (min-width: 640px) {
    :global(html[data-theme='classic']) .detail__badge {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
    }
  }

  :global(html[data-theme='classic']) .detail__name {
    font-size: 1.875rem;
    letter-spacing: normal;
    line-height: 1.15;
    color: #111827;
    margin-bottom: 0.5rem;
  }

  @media (min-width: 768px) {
    :global(html[data-theme='classic']) .detail__name {
      font-size: 2.25rem;
    }
  }

  :global(html[data-theme='classic']) .detail__sci {
    font-size: 1.25rem;
    color: #4b5563;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    :global(html[data-theme='classic']) .detail__sci {
      font-size: 1.5rem;
    }
  }

  /* The blue "About this species" card, with size/weight moved back below the
     prose and under a rule, the way the original page had it. */
  :global(html[data-theme='classic']) .detail__about {
    display: flex;
    flex-direction: column;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 0.5rem;
    padding: 1rem;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -2px rgba(0, 0, 0, 0.1);
  }

  @media (min-width: 640px) {
    :global(html[data-theme='classic']) .detail__about {
      padding: 1.5rem;
    }
  }

  :global(html[data-theme='classic']) .detail__about-title {
    order: 1;
    font-size: 1.25rem;
    font-weight: 700;
    color: #1e3a8a;
    margin: 0 0 0.75rem;
  }

  @media (min-width: 640px) {
    :global(html[data-theme='classic']) .detail__about-title {
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }
  }

  :global(html[data-theme='classic']) .detail__desc {
    order: 2;
    font-size: 1rem;
    line-height: 1.625;
    color: #374151;
    opacity: 1;
  }

  @media (min-width: 640px) {
    :global(html[data-theme='classic']) .detail__desc {
      font-size: 1.125rem;
    }
  }

  :global(html[data-theme='classic']) .detail__stats {
    order: 3;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 1.5rem 0 0;
    border-top: 1px solid #bfdbfe;
    padding-top: 1rem;
  }

  @media (min-width: 640px) {
    :global(html[data-theme='classic']) .detail__stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  :global(html[data-theme='classic']) .detail__stats > div {
    padding: 0;
    border: none;
    background: none;
    min-width: 0;
  }

  :global(html[data-theme='classic']) .detail__stats span {
    font-size: 1rem;
    font-weight: 600;
    color: #1e40af;
    margin-bottom: 0.125rem;
  }

  @media (min-width: 640px) {
    :global(html[data-theme='classic']) .detail__stats span {
      font-size: 1.125rem;
    }
  }

  :global(html[data-theme='classic']) .detail__stats strong {
    font-size: 0.875rem;
    font-weight: 400;
    color: #374151;
  }

  @media (min-width: 640px) {
    :global(html[data-theme='classic']) .detail__stats strong {
      font-size: 1rem;
    }
  }

  /* --- lightbox ---------------------------------------------------------- */

  .detail-lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(3, 11, 19, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    cursor: zoom-out;
  }

  .detail-lightbox[hidden] {
    display: none;
  }

  .detail-lightbox__close {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .detail-lightbox figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 96vw;
    max-height: 92vh;
  }

  .detail-lightbox :global(img) {
    max-width: 96vw;
    max-height: 78vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 30px 90px -20px rgba(0, 0, 0, 0.85);
  }

  .detail-lightbox figcaption {
    text-align: center;
  }

  .detail-lightbox__common {
    font-family: 'Spectral', ui-serif, Georgia, serif;
    font-size: 21px;
    font-weight: 500;
    color: #fff;
  }

  .detail-lightbox__sci {
    font-family: 'Spectral', ui-serif, Georgia, serif;
    font-style: italic;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.65);
    margin-top: 3px;
  }
</style>

<script>
  const trigger = document.querySelector('[data-detail-zoom]');
  const lightbox = document.querySelector(
    '[data-lightbox]'
  ) as HTMLElement | null;

  if (trigger && lightbox) {
    trigger.addEventListener('click', () => {
      // Classic renders the photo in a static frame with no zoom affordance.
      if (document.documentElement.dataset.theme === 'classic') return;
      lightbox.hidden = false;
    });
    lightbox.addEventListener('click', () => (lightbox.hidden = true));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') lightbox.hidden = true;
    });
  }
</script>
