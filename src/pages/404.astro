---
import Layout from '../layouts/Layout.astro';
import SpeciesCard from '../components/SpeciesCard.astro';
import { byId, counts, nodes, shortLabel } from '../utils/whales';

// A handful of well-known species, so the page is a way back into the site
// rather than a dead end. Picked by hand: these are the whales someone is
// most likely to have been looking for when they mistyped a URL.
const SUGGESTED = [
  'b_musculus',
  'm_novaeangliae',
  'p_macrocephalus',
  'mo_monoceros',
];
const suggestions = SUGGESTED.map((id) => byId[id]).filter(Boolean);

const families = nodes.filter((n) => n.type === 'family');
---

<Layout
  title="Page not found | Whale Encyclopedia"
  description={`That page does not exist. Browse all ${counts.species} living whale species instead.`}
>
  <section class="nf">
    <div class="kicker atlas-only">Error 404</div>
    <h1 class="t-display nf__title">This one got away</h1>
    <p class="nf__lede">
      There is no page at that address. It may have moved, or the link may have
      been mistyped — every one of the {counts.species} living whale species has
      a page, so the one you wanted is probably still here.
    </p>

    <div class="nf__actions">
      <a class="wbtn nf__cta" href="/species">
        Browse all {counts.species} species
      </a>
      <a class="nf__link" href="/">Back to the taxonomy tree</a>
    </div>

    <h2 class="t-display nf__heading">Families</h2>
    <ul class="nf__families">
      {
        families.map((family) => (
          <li>
            <a href={`/family/${family.id}`}>{shortLabel(family.label)}</a>
          </li>
        ))
      }
    </ul>

    <h2 class="t-display nf__heading">Start somewhere</h2>
    <div class="nf__grid">
      {suggestions.map((s) => <SpeciesCard species={s} />)}
    </div>
  </section>
</Layout>

<style>
  .kicker {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .nf {
    margin-top: 30px;
  }

  .nf__title {
    font-size: clamp(36px, 5.4vw, 60px);
    line-height: 1;
    letter-spacing: -1px;
    margin: 0 0 18px;
  }

  .nf__lede {
    font-size: clamp(15px, 2vw, 17px);
    line-height: 1.65;
    color: var(--muted);
    max-width: 560px;
    margin: 0 0 28px;
  }

  /* `.wbtn` only carries the shadow and hover; every page that uses it gives
     it its own shape, the way the homepage CTA does. */
  .nf__cta {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 24px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-bottom: 8px;
  }

  .nf__link {
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
  }

  .nf__link:hover {
    color: var(--accent);
  }

  .nf__heading {
    font-size: clamp(20px, 2.4vw, 26px);
    letter-spacing: -0.3px;
    margin: 48px 0 18px;
  }

  .nf__families {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .nf__families a {
    display: inline-block;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-size: 13px;
    text-decoration: none;
  }

  .nf__families a:hover {
    color: var(--accent);
  }

  .nf__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 18px;
  }

  :global(html[data-theme='classic']) .nf__title {
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: normal;
    line-height: 1.15;
  }

  :global(html[data-theme='classic']) .nf__families a {
    background: #fff;
    border-color: #e5e7eb;
    color: #374151;
  }

  :global(html[data-theme='classic']) .nf__grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    :global(html[data-theme='classic']) .nf__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
