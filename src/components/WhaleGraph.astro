---
import { graphData, speciesThumbnails } from '../utils/whales';

/**
 * Radial taxonomy graph, ported from the Whale Atlas design.
 *
 * The nodes, links, panels and lightbox are all built in the browser, so the
 * taxonomy travels as JSON and the species photos travel as pre-optimised URLs
 * produced by Astro's image pipeline at build time.
 *
 * Unlike the original design, selecting a species does not swap an in-page
 * view: the panel's primary action navigates to the real /species/[id] page,
 * so every species stays a crawlable URL.
 */
const thumbs = await speciesThumbnails(560);
const payload = JSON.stringify(graphData(thumbs)).replace(/</g, '\\u003c');
---

<script
  is:inline
  type="application/json"
  data-whale-graph-data
  set:html={payload}
/>

<section class="wstage" data-stage aria-label="Whale taxonomy graph">
  <div class="wstage__vignette" aria-hidden="true"></div>

  <div class="wglass wstage__crumbs" data-crumbs></div>

  <div class="wglass wstage__zoom">
    <button class="wctrl" data-zoom-in aria-label="Zoom in">
      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"><path d="M7 1.5v11M1.5 7h11"></path></svg
      >
    </button>
    <div class="wstage__zoom-sep"></div>
    <button class="wctrl" data-zoom-out aria-label="Zoom out">
      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"><path d="M1.5 7h11"></path></svg
      >
    </button>
    <div class="wstage__zoom-sep"></div>
    <button class="wctrl" data-reset aria-label="Reset view">
      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M2.2 7a4.8 4.8 0 1 0 1.4-3.4"></path><path d="M2 1.8v2.4h2.4"
        ></path></svg
      >
    </button>
  </div>

  <div class="whint" aria-hidden="true">
    <span>Drag to explore</span>
    <span>Tap <b>+</b> to branch out</span>
    <span>Tap a node to list its whales</span>
  </div>

  <div class="wviewport" data-viewport></div>
</section>

<!-- Species detail panel -->
<aside
  class="wpanel wpanel--species"
  data-species-panel
  hidden
  aria-label="Species detail"
>
  <div class="wpanel__media">
    <img data-sp-img alt="" loading="lazy" />
    <span class="wpanel__zoom" data-sp-zoom>⤢ Full size</span>
    <button class="wclose wpanel__close" data-sp-close aria-label="Close"
      >×</button
    >
    <span class="wpanel__status" data-sp-status></span>
  </div>
  <div class="wpanel__body">
    <div class="wpanel__lineage" data-sp-lineage></div>
    <h3 class="wpanel__title" data-sp-common></h3>
    <p class="t-sci wpanel__sci" data-sp-sci></p>
    <div class="wpanel__stats">
      <div><span>Length</span><strong data-sp-size></strong></div>
      <div><span>Weight</span><strong data-sp-weight></strong></div>
    </div>
    <p class="wpanel__desc" data-sp-desc></p>
    <a class="wbtn wpanel__cta" data-sp-link href="/">View full profile</a>
    <button class="wback wpanel__secondary" data-sp-siblings></button>
  </div>
</aside>

<!-- Taxon species list panel -->
<aside
  class="wpanel wpanel--list"
  data-list-panel
  hidden
  aria-label="Species in taxon"
>
  <div class="wpanel__head">
    <div>
      <div class="wpanel__kicker" data-lp-kicker></div>
      <h3 class="wpanel__title" data-lp-title></h3>
      <div class="wpanel__count" data-lp-count></div>
    </div>
    <button class="wclose wpanel__head-close" data-lp-close aria-label="Close"
      >×</button
    >
  </div>
  <div class="wpanel__rows" data-lp-rows></div>
  <a class="wback wpanel__browse" data-lp-link href="/">Open full page</a>
</aside>

<!-- Lightbox -->
<div class="wlightbox" data-lightbox hidden>
  <button class="wclose wlightbox__close" data-lb-close aria-label="Close"
    >×</button
  >
  <figure>
    <img data-lb-img alt="" />
    <figcaption>
      <div class="wlightbox__common" data-lb-common></div>
      <div class="wlightbox__sci" data-lb-sci></div>
    </figcaption>
  </figure>
</div>

<style>
  .wstage {
    position: relative;
    height: clamp(440px, 68vh, 740px);
    border-radius: 28px;
    background: var(--stage-bg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .wstage__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      120% 90% at 50% 50%,
      transparent 60%,
      rgba(0, 0, 0, 0.14)
    );
    pointer-events: none;
    z-index: 3;
  }

  .wstage__crumbs {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: calc(100% - 90px);
    overflow-x: auto;
    padding: 0 14px;
    height: 36px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--muted);
    scrollbar-width: none;
  }

  .wstage__crumbs::-webkit-scrollbar {
    display: none;
  }

  .wstage__crumbs :global(.wcrumb) {
    white-space: nowrap;
    background: none;
    border: none;
    font: inherit;
    color: inherit;
    padding: 0;
  }

  .wstage__crumbs :global(.wcrumb-sep) {
    color: var(--faint);
    font-size: 11px;
  }

  .wstage__zoom {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 4;
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .wstage__zoom button {
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wstage__zoom-sep {
    height: 1px;
    background: var(--border);
    margin: 0 8px;
  }

  .whint {
    position: absolute;
    left: 16px;
    bottom: 14px;
    z-index: 4;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-size: 12px;
    color: var(--faint);
    pointer-events: none;
    max-width: calc(100% - 32px);
  }

  .whint span {
    white-space: nowrap;
  }

  .whint b {
    color: var(--muted);
    font-weight: 600;
  }

  /* --- panels ----------------------------------------------------------- */

  .wpanel {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 60;
    width: min(400px, calc(100vw - 32px));
    max-height: 84vh;
    overflow-y: auto;
    border-radius: 20px;
    background: var(--panel-bg);
    border: 1px solid var(--border-2);
    box-shadow: 0 30px 80px -24px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .wpanel--list {
    width: min(420px, calc(100vw - 32px));
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .wpanel[hidden] {
    display: none;
  }

  .wpanel__media {
    position: relative;
  }

  .wpanel__media img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
    border-radius: 20px 20px 0 0;
    background: rgba(0, 0, 0, 0.15);
    cursor: zoom-in;
  }

  .wpanel__zoom {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 600;
    color: #fff;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
    cursor: zoom-in;
  }

  .wpanel__close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    font-size: 18px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(6px);
  }

  .wpanel__status {
    position: absolute;
    bottom: 12px;
    left: 14px;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.3px;
    color: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
  }

  .wpanel__body {
    padding: 20px 22px 24px;
  }

  .wpanel__lineage {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.4px;
    color: var(--faint);
    margin-bottom: 6px;
  }

  .wpanel__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 26px;
    line-height: 1.1;
    margin: 0 0 4px;
  }

  .wpanel__sci {
    font-size: 15px;
    margin: 0 0 18px;
  }

  .wpanel__stats {
    display: flex;
    gap: 10px;
    margin-bottom: 18px;
  }

  .wpanel__stats > div {
    flex: 1;
    padding: 11px 14px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
  }

