---
import Layout from '../layouts/Layout.astro';
import SpeciesCard from '../components/SpeciesCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import {
  byId,
  childrenOf,
  commonLabel,
  lineageOf,
  sciName,
  shortLabel,
  speciesUnder,
  type WhaleNode,
} from '../utils/whales';
import { TAXON_COPY } from '../data/taxonCopy';
import {
  breadcrumbList,
  canonicalUrl,
  graph,
  higherTaxon,
  publisher,
  socialImageForTaxon,
  taxonDescription,
  taxonItemList,
  webPage,
  webSite,
} from '../utils/seo';

export interface Props {
  taxon: WhaleNode;
  /** Heading above the grid, e.g. "Species in this Family". */
  heading: string;
}

const { taxon, heading } = Astro.props;

const species = speciesUnder(taxon.id);
const trail = lineageOf(taxon.id);
const rank = taxon.type.charAt(0).toUpperCase() + taxon.type.slice(1);

const name = sciName(taxon);
const common = taxon.common_name || commonLabel(taxon.label);
const copy = TAXON_COPY[taxon.id];

/**
 * What to put after the name in the <title>. A vernacular name if the taxon
 * has one; the single species' name if the taxon holds exactly one; otherwise
 * the count, which is the next most useful thing a searcher can see.
 */
const subtitle =
  common ||
  (species.length === 1
    ? species[0].common_name || species[0].label
    : `${species.length} whale species`);

const title = `${name} — ${subtitle} | Whale Encyclopedia`;
const description = taxonDescription(taxon, species.length, copy?.summary);
const social = await socialImageForTaxon(taxon, species);

const url = canonicalUrl(`/${taxon.type}/${taxon.id}`);
const children = childrenOf(taxon.id);
const jsonLd = graph([
  webSite(),
  publisher(),
  webPage({
    url,
    name: `${name}${common ? ` (${common})` : ''}`,
    description,
    primaryEntityId: `${url}#taxon`,
    breadcrumbId: `${url}#breadcrumbs`,
  }),
  breadcrumbList(trail),
  higherTaxon(taxon, children, copy?.summary),
  taxonItemList(url, heading, species),
]);

/** Family name for the Atlas card kicker — species cards sit under mixed ranks. */
function kickerFor(s: WhaleNode) {
  const genus = s.parent ? byId[s.parent] : undefined;
  const family = genus?.parent ? byId[genus.parent] : undefined;
  return family ? shortLabel(family.label) : undefined;
}
---

<Layout title={title} description={description} image={social} jsonLd={jsonLd}>
  <Breadcrumbs trail={trail} />

  <header class="taxon">
    <div class="kicker atlas-only">{rank}</div>
    <h1 class="t-display taxon__name">{name}</h1>
    {common && <p class="taxon__common">{common}</p>}
    {
      (copy?.summary || taxon.description) && (
        <p class="taxon__desc">{copy?.summary ?? taxon.description}</p>
      )
    }

    <div class="taxon__stats atlas-only">
      <div>
        <div class="t-display taxon__stat-value">{species.length}</div>
        <div class="taxon__stat-label">species</div>
      </div>
    </div>
  </header>

  {
    copy && (
      <section class="taxon__article">
        <h2 class="t-display taxon__article-title">
          About {common ? `the ${common.toLowerCase()}` : name}
        </h2>
        {copy.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </section>
    )
  }

  <h2 class="t-display taxon__heading">{heading}</h2>

  <div class="taxon__grid">
    {species.map((s) => <SpeciesCard species={s} kicker={kickerFor(s)} />)}
  </div>
</Layout>

<style>
  .kicker {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .taxon__name {
    font-size: clamp(34px, 4.8vw, 54px);
    line-height: 1;
    letter-spacing: -0.8px;
    margin: 0 0 10px;
  }

  .taxon__common {
    font-family: var(--font-display);
    font-size: clamp(17px, 2.2vw, 21px);
    color: var(--muted);
    margin: 0 0 20px;
  }

  .taxon__desc {
    font-size: 16px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 640px;
    margin: 0 0 8px;
  }

  .taxon__stats {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    margin-top: 28px;
    padding: 24px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .taxon__stat-value {
    font-size: 36px;
    line-height: 1;
  }

  .taxon__stat-label {
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 8px;
  }

  .taxon__article {
    max-width: 680px;
    margin-top: 44px;
  }

  .taxon__article-title {
    font-size: clamp(22px, 2.6vw, 28px);
    letter-spacing: -0.3px;
    margin: 0 0 18px;
  }

  .taxon__article p {
    font-size: 16px;
    line-height: 1.75;
    color: var(--muted);
    margin: 0 0 18px;
  }

  .taxon__article p:last-child {
    margin-bottom: 0;
  }

  .taxon__heading {
    font-size: clamp(22px, 2.6vw, 28px);
    letter-spacing: -0.3px;
    margin: 48px 0 20px;
  }

  .taxon__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 18px;
  }

  /* --- Classic ----------------------------------------------------------- */

  :global(html[data-theme='classic']) .taxon__name {
    font-size: 1.875rem;
    line-height: 1.15;
    letter-spacing: normal;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  @media (min-width: 768px) {
    :global(html[data-theme='classic']) .taxon__name {
      font-size: 2.25rem;
    }
  }

  :global(html[data-theme='classic']) .taxon__common {
    font-family: inherit;
    font-size: 1.25rem;
    color: #374151;
    margin-bottom: 1.5rem;
  }

  :global(html[data-theme='classic']) .taxon__desc {
    font-size: 1rem;
    color: #374151;
    margin-bottom: 2rem;
  }

  :global(html[data-theme='classic']) .taxon__article-title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: normal;
    border-bottom: 1px solid #93c5fd;
    padding-bottom: 0.5rem;
  }

  :global(html[data-theme='classic']) .taxon__article p {
    color: #374151;
  }

  :global(html[data-theme='classic']) .taxon__heading {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: normal;
    margin: 0 0 1rem;
  }

  :global(html[data-theme='classic']) .taxon__grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    :global(html[data-theme='classic']) .taxon__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    :global(html[data-theme='classic']) .taxon__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
