---
import '../styles/global.css';
import { Image } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import whaleIcon from '../assets/whale.svg';
import ThemeToggle from '../components/ThemeToggle.astro';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Whale Encyclopedia',
  description = 'A comprehensive guide to whale species',
} = Astro.props;

const path = Astro.url.pathname;
const isSpeciesIndex = path === '/species' || path === '/species/';
const isHome = path === '/';

const navTabs = [
  { href: '/', label: 'Tree', current: isHome },
  { href: '/species', label: 'Species', current: isSpeciesIndex },
];

const canonical = new URL(path, Astro.site ?? 'https://whales.rocks');

// Single-path whale mark from the Atlas design — inlined so the Atlas header
// can tint it with the accent colour via currentColor.
const WHALE_PATH =
  'M944.7 435.7c11.5 13.5 16.4 31.2 13.6 48.6 0 0.2 0 0.4-0.1 0.5-10.8 65.6-41.5 125.2-88.7 172.3-25.2 25.2-54.2 45.7-85.7 61.1-31.5 15.3-65.5 25.4-100.7 29.6-6 12.4-16.4 22.5-29.4 27.9l-169 71.2c-6.1 2.1-12 1-14.2 0.1-4.6-1.9-8.2-5.5-10.1-10-12.7-30.1-13.1-62.3-3.6-91.1-69.4-11.2-133.1-45.2-181.4-97.4-54.5-58.8-84.5-135.4-84.5-215.7V328.5c0-4.3 0.6-8.5 1.6-12.5h-32.6c-52.8 0-95.7-42.9-95.7-95.7v-25.6c0-10.3 8.3-18.6 18.6-18.6h55.8c41 0 78.3 20.9 100.4 53.4 22.1-32.4 59.4-53.4 100.4-53.4h55.8c10.3 0 18.6 8.3 18.6 18.6v25.6c0 52.8-42.9 95.7-95.7 95.7h-29.5c0.3 1.1 0.6 2.2 0.8 3.3 10.4 55 58.7 95 114.9 95h494.2c17.7 0 34.6 7.8 46.2 21.4z';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Resolve the theme before first paint so switching back to Classic
         doesn't flash the dark Atlas background on every navigation. -->
    <script is:inline>
      (function () {
        var theme = 'atlas';
        try {
          if (localStorage.getItem('whale-theme') === 'classic')
            theme = 'classic';
        } catch {
          /* storage blocked — fall through to the Atlas default */
        }
        var root = document.documentElement;
        root.setAttribute('data-theme', theme);
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            root.setAttribute('data-reduce', '1');
          }
        } catch {
          /* matchMedia unavailable — animations stay on */
        }
      })();
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO Meta Tags -->
    <meta name="author" content="Vic and Andrei Pop" />
    <meta
      name="keywords"
      content="whales, cetaceans, marine mammals, ocean, conservation, endangered species, whale species, whale encyclopedia"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://whales.rocks/og-image.png" />
    <meta property="og:site_name" content="Whale Encyclopedia" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://whales.rocks/og-image.png" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- Ambient light field behind the Atlas theme. Purely decorative. -->
    <div class="wambient atlas-only" aria-hidden="true">
      <div class="wambient__blob wambient__blob--a"></div>
      <div class="wambient__blob wambient__blob--b"></div>
      <svg class="wambient__whale" viewBox="0 0 1024 1024" fill="currentColor">
        <path d={WHALE_PATH}></path>
      </svg>
    </div>

    <!-- Atlas chrome -->
    <header class="atlas-only atlas-header">
      <a href="/" class="atlas-header__brand">
        <svg viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true">
          <path d={WHALE_PATH}></path>
        </svg>
        <span>Cetacea<span class="atlas-header__brand-dim"> Atlas</span></span>
      </a>
      <div class="atlas-header__actions">
        <nav class="atlas-header__tabs wglass" aria-label="Primary">
          {
            navTabs.map((tab) => (
              <a
                class="wtab"
                href={tab.href}
                aria-current={tab.current ? 'page' : undefined}
              >
                {tab.label}
              </a>
            ))
          }
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <!-- Classic chrome -->
    <header class="classic-only bg-nav p-4 text-white md:p-6">
      <div class="container mx-auto">
        <div class="text-center">
          <div class="mb-2 flex items-center justify-center gap-4">
            <a href="/">
              <Image
                src={whaleIcon}
                alt="Whale Icon"
                class="h-12 w-12 md:h-16 md:w-16"
                width={64}
                height={64}
              />
            </a>
            <h1 class="text-2xl font-bold md:text-4xl">Whale Encyclopedia</h1>
          </div>
          <p class="text-blue-100">
            Discover the magnificent cetaceans of our oceans
          </p>
          <div class="mt-4 flex justify-center gap-2">
            <a
              href="/species"
              class="classic-navlink"
              aria-current={isSpeciesIndex ? 'page' : undefined}>All species</a
            >
            <ThemeToggle />
          </div>
        </div>
      </div>
    </header>

    <main class="page-main flex-grow">
      <slot />
    </main>

    <!-- Atlas footer -->
    <footer class="atlas-only atlas-footer">
      <div class="atlas-footer__inner">
        <p>
          Taxonomy and conservation status compiled from IUCN Red List
          assessments. Species imagery via Wikimedia Commons under their
          respective licenses.
        </p>
        <p class="atlas-footer__meta">
          &copy; {new Date().getFullYear()} Whale Encyclopedia{' · '}
          <a href="https://vicusbass.com" target="_blank" rel="noopener"
            >Made by Vic and Andrei Pop</a
          >{' · '}
          <a href="https://coff.ee/vicusbass" target="_blank" rel="noopener"
            >Buy me a coffee</a
          >
        </p>
      </div>
    </footer>

    <!-- Classic footer -->
    <footer class="classic-only bg-nav mt-auto p-4 text-white">
      <div class="container mx-auto text-center">
        <p>&copy; {new Date().getFullYear()} Whale Encyclopedia</p>
        <p class="mt-1 text-sm text-blue-200">
          Data compiled from scientific research and conservation organizations
        </p>
        <div
          class="mt-3 flex flex-col items-center justify-center gap-3 md:flex-row"
        >
          <p class="text-sm text-blue-100">
            <a href="https://vicusbass.com" target="_blank" rel="noopener"
              >Made by Vic and Andrei Pop</a
            >
          </p>
          <a
            href="https://coff.ee/vicusbass"
            target="_blank"
            rel="noopener"
            class="bg-accent flex items-center gap-2 rounded-md px-3 py-1 text-sm text-white transition-colors hover:text-gray-900"
          >
            <span class="icon-[tabler--coffee] h-4 w-4"></span>
            Buy me a coffee
          </a>
        </div>
      </div>
    </footer>
    <Analytics />
  </body>
</html>

<style>
  /* --- shared shell --------------------------------------------------- */

  .page-main {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px 22px 64px;
  }

  :global(html[data-theme='classic']) .page-main {
    max-width: 80rem;
    padding: 1rem;
  }

  @media (min-width: 768px) {
    :global(html[data-theme='classic']) .page-main {
      padding: 1.5rem;
    }
  }

  /* --- ambient --------------------------------------------------------- */

  .wambient {
    position: fixed;
    inset: -40px;
    pointer-events: none;
    z-index: 0;
    opacity: var(--ambient);
    overflow: hidden;
  }

  .wambient__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }

  .wambient__blob--a {
    top: -10%;
    left: -8%;
    width: 46vw;
    height: 46vw;
    background: radial-gradient(circle, var(--accent), transparent 62%);
    opacity: 0.16;
    animation: wfloat 13s ease-in-out infinite;
  }

  .wambient__blob--b {
    bottom: -12%;
    right: -6%;
    width: 42vw;
    height: 42vw;
    background: radial-gradient(circle, var(--accent-2), transparent 62%);
    opacity: 0.14;
    filter: blur(90px);
    animation: wfloat 17s ease-in-out infinite reverse;
  }

  .wambient__whale {
    position: absolute;
    right: 4%;
    top: 38%;
    width: min(520px, 46vw);
    opacity: 0.05;
    color: var(--accent);
    transform: scaleX(-1);
  }

  /* --- atlas header ---------------------------------------------------- */

  .atlas-header {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 26px 22px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .atlas-header__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.2px;
  }

  .atlas-header__brand svg {
    width: 26px;
    height: 26px;
    color: var(--accent);
    flex: none;
  }

  .atlas-header__brand-dim {
    color: var(--faint);
    font-weight: 400;
  }

  .atlas-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .atlas-header__tabs {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .atlas-header__tabs .wtab {
    border: none;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    padding: 7px 18px;
    border-radius: 999px;
    text-decoration: none;
  }

  /* --- classic header extras ------------------------------------------- */

  .classic-navlink {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 15px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }

  .classic-navlink:hover,
  .classic-navlink[aria-current='page'] {
    background: rgba(255, 255, 255, 0.28);
  }

  /* --- atlas footer ----------------------------------------------------- */

  .atlas-footer {
    position: relative;
    z-index: 1;
    margin-top: auto;
    margin-inline: auto;
    width: 100%;
    max-width: 1180px;
    padding: 0 22px 40px;
  }

  .atlas-footer__inner {
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    color: var(--faint);
    line-height: 1.6;
    max-width: 560px;
  }

  .atlas-footer__inner p {
    margin: 0;
  }

  .atlas-footer__meta {
    margin-top: 8px !important;
  }

  .atlas-footer a {
    color: var(--muted);
    text-decoration: none;
  }

  .atlas-footer a:hover {
    color: var(--accent);
  }
</style>
